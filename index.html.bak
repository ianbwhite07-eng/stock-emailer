<!DOCTYPE html>
<html lang="en">
<head><link rel="icon" href="data:,">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stock Dashboard</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; background: #0f0f0f; color: #e0e0e0; padding: 24px; }
    h1 { font-size: 22px; font-weight: 500; margin-bottom: 4px; }
    .subtitle { font-size: 13px; color: #666; margin-bottom: 20px; }

    .tabs { display: flex; gap: 0; margin-bottom: 28px; border-bottom: 0.5px solid #2a2a2a; }
    .tab-btn { padding: 10px 22px; font-size: 13px; font-weight: 500; background: none; border: none; color: #555; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -0.5px; transition: all 0.15s; }
    .tab-btn:hover { color: #aaa; background: none; }
    .tab-btn.active { color: #e0e0e0; border-bottom-color: #4ade80; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .portfolio-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px; }
    .stat-card { background: #1a1a1a; border: 0.5px solid #2a2a2a; border-radius: 10px; padding: 14px 16px; }
    .stat-label { font-size: 11px; color: #666; margin-bottom: 6px; }
    .stat-value { font-size: 22px; font-weight: 500; }
    .stat-value.green { color: #4ade80; }
    .stat-value.red   { color: #f87171; }

    .btn-row { display: flex; gap: 10px; margin-bottom: 16px; align-items: center; flex-wrap: wrap; }
    button { background: #1a1a1a; border: 0.5px solid #333; color: #e0e0e0; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 13px; transition: background 0.15s; }
    button:hover { background: #252525; }
    button.primary { border-color: #4ade80; color: #4ade80; }
    button.danger  { border-color: #f87171; color: #f87171; }

    .add-bar { display: flex; gap: 8px; align-items: center; margin-bottom: 20px; }
    .add-bar input { background: #1a1a1a; border: 0.5px solid #444; color: #e0e0e0; padding: 8px 12px; border-radius: 8px; font-size: 13px; width: 140px; text-transform: uppercase; }
    .add-bar input::placeholder { color: #555; text-transform: none; }
    .add-bar input:focus { outline: none; border-color: #4ade80; }
    .add-msg { font-size: 12px; }
    .add-msg.ok  { color: #4ade80; }
    .add-msg.err { color: #f87171; }

    .sort-bar { display: flex; gap: 8px; align-items: center; margin-bottom: 20px; flex-wrap: wrap; }
    .sort-label { font-size: 12px; color: #666; margin-right: 4px; }
    .sort-btn { padding: 6px 14px; font-size: 12px; border-radius: 20px; }
    .sort-btn.active-alpha   { background: #1a1a1a; border-color: #888;    color: #ccc; }
    .sort-btn.active-short   { background: #0d1a2a; border-color: #60a5fa; color: #60a5fa; }
    .sort-btn.active-mid     { background: #150d2a; border-color: #a78bfa; color: #a78bfa; }
    .sort-btn.active-long    { background: #0d1a0d; border-color: #4ade80; color: #4ade80; }
    .sort-btn.active-overall { background: #2a1f0d; border-color: #fbbf24; color: #fbbf24; }

    .alerts { margin-bottom: 20px; }
    .alert-box { background: #2a1f1f; border: 0.5px solid #f87171; border-radius: 8px; padding: 10px 14px; margin-bottom: 8px; font-size: 13px; color: #f87171; }

    .table-wrap { background: #1a1a1a; border: 0.5px solid #2a2a2a; border-radius: 12px; overflow-x: auto; margin-bottom: 28px; }
    table { width: 100%; border-collapse: collapse; min-width: 1200px; }
    .group-header { font-size: 10px; font-weight: 600; text-align: center; padding: 6px 0; border-bottom: 0.5px solid #2a2a2a; letter-spacing: 0.05em; text-transform: uppercase; }
    .group-price   { color: #888;    background: #161616; }
    .group-short   { color: #60a5fa; background: #0d1a2a; }
    .group-mid     { color: #a78bfa; background: #150d2a; }
    .group-long    { color: #4ade80; background: #0d1a0d; }
    .group-overall { color: #fbbf24; background: #1a1400; }
    .group-trade   { color: #888;    background: #161616; }
    th { font-size: 11px; font-weight: 500; color: #555; padding: 8px 14px; text-align: left; border-bottom: 0.5px solid #2a2a2a; white-space: nowrap; }
    th.short   { color: #60a5fa; }
    th.mid     { color: #a78bfa; }
    th.long    { color: #4ade80; }
    th.overall { color: #fbbf24; }
    td { padding: 11px 14px; font-size: 13px; border-bottom: 0.5px solid #1f1f1f; white-space: nowrap; vertical-align: top; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #1f1f1f; }
    .alert-row td { background: #1f1515 !important; }

    .badge { display: inline-block; font-size: 11px; font-weight: 500; padding: 3px 8px; border-radius: 6px; }
    .badge.strong-buy  { background: #14532d; color: #4ade80; }
    .badge.buy         { background: #1a3a1a; color: #86efac; }
    .badge.hold        { background: #2a2510; color: #fbbf24; }
    .badge.sell        { background: #2a1515; color: #f87171; }
    .badge.strong-sell { background: #3a0f0f; color: #ef4444; }
    .badge.na          { background: #1f1f1f; color: #555; }
    .badge.bullish     { background: #14532d; color: #4ade80; }
    .badge.bearish     { background: #3a0f0f; color: #ef4444; }
    .badge.neutral     { background: #222;    color: #888; }
    .badge.uptrend     { background: #14532d; color: #4ade80; }
    .badge.downtrend   { background: #3a0f0f; color: #ef4444; }
    .badge.flat        { background: #222;    color: #888; }

    .change.pos { color: #4ade80; }
    .change.neg { color: #f87171; }
    .earnings-beat  { color: #4ade80; }
    .earnings-miss  { color: #f87171; }
    .earnings-mixed { color: #fbbf24; }
    .sub-text { font-size: 10px; color: #555; margin-top: 2px; }
    .analyst-breakdown { font-size: 10px; color: #555; margin-top: 3px; }
    .rating-ts { font-size: 10px; color: #444; margin-top: 2px; }

    .score-cell { position: relative; cursor: help; }
    .score-ring { display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 50%; font-size: 14px; font-weight: 600; border: 2px solid; }
    .score-ring.s-high { border-color: #4ade80; color: #4ade80; background: #0d1a0d; }
    .score-ring.s-mid  { border-color: #fbbf24; color: #fbbf24; background: #1a1400; }
    .score-ring.s-low  { border-color: #f87171; color: #f87171; background: #1a0d0d; }
    .score-ring.s-na   { border-color: #333;    color: #555;    background: #1a1a1a; }
    .tooltip { display: none; position: absolute; right: 0; top: 48px; z-index: 100; background: #1e1e1e; border: 0.5px solid #333; border-radius: 10px; padding: 12px 14px; width: 240px; font-size: 11px; line-height: 1.7; box-shadow: 0 8px 24px rgba(0,0,0,0.6); }
    .score-cell:hover .tooltip { display: block; }
    .tooltip-row { display: flex; justify-content: space-between; }
    .tooltip-label { color: #888; }
    .tooltip-val   { color: #e0e0e0; font-weight: 500; }
    .tooltip-divider { border: none; border-top: 0.5px solid #2a2a2a; margin: 6px 0; }
    .tooltip-total { display: flex; justify-content: space-between; font-weight: 600; color: #fbbf24; }

    /* History tooltip */
    .hist-cell { position: relative; }
    .hist-btn { background: none; border: 0.5px solid #333; color: #666; font-size: 11px; padding: 4px 10px; border-radius: 6px; cursor: pointer; }
    .hist-btn:hover { border-color: #555; color: #aaa; background: none; }
    .hist-tooltip { display: none; position: absolute; right: 0; top: 34px; z-index: 200; background: #1e1e1e; border: 0.5px solid #333; border-radius: 10px; padding: 12px 14px; width: 280px; font-size: 11px; box-shadow: 0 8px 24px rgba(0,0,0,0.7); }
    .hist-cell:hover .hist-tooltip { display: block; }
    .hist-title { font-size: 11px; font-weight: 600; color: #888; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.05em; }
    .hist-row { display: grid; grid-template-columns: 80px 58px 40px 40px 40px 50px; gap: 4px; padding: 5px 0; border-bottom: 0.5px solid #2a2a2a; font-size: 11px; }
    /* News tooltip */
    .news-cell { position: relative; }
    .news-btn { background: none; border: 0.5px solid #333; color: #666; font-size: 11px; padding: 4px 10px; border-radius: 6px; cursor: pointer; }
    .news-btn:hover { border-color: #555; color: #aaa; background: none; }
    .news-tooltip { display: none; position: absolute; right: 0; top: 34px; z-index: 200; background: #1e1e1e; border: 0.5px solid #333; border-radius: 10px; padding: 12px 14px; width: 320px; font-size: 11px; box-shadow: 0 8px 24px rgba(0,0,0,0.7); }
    .news-cell:hover .news-tooltip { display: block; }
    .news-headline { padding: 6px 0; border-bottom: 0.5px solid #2a2a2a; line-height: 1.4; }
    .news-headline:last-child { border-bottom: none; }
    .news-headline a { color: #c8d6e5; text-decoration: none; }
    .news-headline a:hover { color: #fff; text-decoration: underline; }
    .news-source { color: #555; font-size: 10px; margin-top: 2px; }
    .news-sent-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 0.5px solid #2a2a2a; }
    .news-sent-label { color: #888; font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; }
    .hist-row:last-child { border-bottom: none; }
    .hist-row.header { color: #555; font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; }
    .hist-date { color: #777; }
    .hist-val  { color: #e0e0e0; text-align: center; }
    .no-hist   { color: #555; font-size: 12px; }

    .legend { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 12px; }
    .legend-card { border-radius: 8px; padding: 12px 14px; border: 0.5px solid; }
    .legend-card.short { background: #0d1a2a; border-color: #1e3a5f; }
    .legend-card.mid   { background: #150d2a; border-color: #2d1a5f; }
    .legend-card.long  { background: #0d1a0d; border-color: #1a3a1a; }
    .legend-title { font-size: 12px; font-weight: 600; margin-bottom: 6px; }
    .legend-card.short .legend-title { color: #60a5fa; }
    .legend-card.mid   .legend-title { color: #a78bfa; }
    .legend-card.long  .legend-title { color: #4ade80; }
    .legend-desc { font-size: 11px; color: #666; line-height: 1.5; }

    /* Metric reference legend */
    .legend-toggle { background: none; border: 0.5px solid #2a2a2a; color: #555; font-size: 12px; padding: 6px 14px; border-radius: 6px; cursor: pointer; margin-bottom: 16px; display: flex; align-items: center; gap: 6px; }
    .legend-toggle:hover { border-color: #444; color: #888; background: none; }
    .legend-toggle-arrow { font-size: 10px; transition: transform 0.2s; }
    .legend-toggle-arrow.open { transform: rotate(90deg); }
    .metric-legend { display: none; background: #141414; border: 0.5px solid #2a2a2a; border-radius: 10px; padding: 16px 18px; margin-bottom: 20px; }
    .metric-legend.open { display: block; }
    .metric-legend-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .metric-block-title { font-size: 11px; font-weight: 600; color: #aaa; margin-bottom: 8px; padding-bottom: 5px; border-bottom: 0.5px solid #2a2a2a; text-transform: uppercase; letter-spacing: 0.05em; }
    .metric-block-desc { font-size: 11px; color: #666; line-height: 1.55; margin-bottom: 8px; }
    .metric-table { width: 100%; border-collapse: collapse; }
    .metric-table td { font-size: 10px; padding: 3px 0; vertical-align: top; border: none; white-space: normal; }
    .metric-table td:first-child { color: #555; width: 52%; padding-right: 6px; }
    .metric-table td:last-child { color: #e0e0e0; }
    .metric-table .good  { color: #4ade80 !important; }
    .metric-table .warn  { color: #fbbf24 !important; }
    .metric-table .bad   { color: #f87171 !important; }
    .metric-table .neu   { color: #888 !important; }

    .portfolio-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }
    .port-card { background: #1a1a1a; border: 0.5px solid #2a2a2a; border-radius: 12px; padding: 20px; }
    .port-card-title { font-size: 13px; font-weight: 600; color: #aaa; margin-bottom: 16px; }
    .holdings-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 0.5px solid #1f1f1f; font-size: 13px; }
    .lot-cell { position: relative; }
    .lot-btn { background: none; border: 0.5px solid #333; color: #666; font-size: 11px; padding: 4px 10px; border-radius: 6px; cursor: pointer; }
    .lot-btn:hover { border-color: #555; color: #aaa; background: none; }
    .lot-tooltip { display: none; position: absolute; right: 0; top: 34px; z-index: 300; background: #1e1e1e; border: 0.5px solid #333; border-radius: 10px; padding: 12px 14px; width: 300px; font-size: 11px; box-shadow: 0 8px 24px rgba(0,0,0,0.7); }
    .lot-cell:hover .lot-tooltip { display: block; }
    .lot-title { font-size: 11px; font-weight: 600; color: #888; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.05em; }
    .lot-row { display: grid; grid-template-columns: 110px 1fr; gap: 4px; padding: 4px 0; border-bottom: 0.5px solid #2a2a2a; font-size: 11px; }
    .lot-row:last-child { border-bottom: none; }
    .lot-label { color: #555; }
    .lot-val { color: #e0e0e0; }
    .holdings-row:last-child { border-bottom: none; }
    .holding-ticker { font-weight: 600; color: #e0e0e0; }
    .holding-detail { font-size: 11px; color: #666; margin-top: 2px; }
    .holding-value  { text-align: right; }
    .holding-pnl.pos { color: #4ade80; font-size: 11px; }
    .holding-pnl.neg { color: #f87171; font-size: 11px; }
    .buy-panel { display: flex; flex-direction: column; gap: 12px; }
    .buy-row { display: flex; gap: 10px; align-items: center; }
    .buy-row select, .buy-row input[type=number] { background: #111; border: 0.5px solid #333; color: #e0e0e0; padding: 8px 12px; border-radius: 8px; font-size: 13px; flex: 1; }
    .buy-row select { flex: 1.5; }
    .buy-hint { font-size: 11px; color: #555; }
    .buy-result { font-size: 12px; color: #4ade80; min-height: 18px; }
    .buy-error  { font-size: 12px; color: #f87171; min-height: 18px; }
    .history-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #141414; border: 0.5px solid #2a2a2a; border-radius: 8px; margin-bottom: 6px; font-size: 12px; }
    .history-buy  { border-left: 2px solid #4ade80; }
    .history-sell { border-left: 2px solid #f87171; }

    .news-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .news-section-title { font-size: 14px; font-weight: 600; color: #aaa; margin-bottom: 14px; }
    .news-card { background: #1a1a1a; border: 0.5px solid #2a2a2a; border-radius: 10px; padding: 14px 16px; margin-bottom: 10px; }
    .news-headline { font-size: 13px; font-weight: 500; color: #e0e0e0; margin-bottom: 4px; line-height: 1.4; }
    .news-headline a { color: #e0e0e0; text-decoration: none; }
    .news-headline a:hover { color: #4ade80; }
    .news-meta { font-size: 11px; color: #555; }
    .news-summary { font-size: 11px; color: #777; margin-top: 6px; line-height: 1.5; }
    .change-card { background: #1f1515; border: 0.5px solid #f87171; border-radius: 10px; padding: 12px 16px; margin-bottom: 8px; font-size: 13px; }
    .change-card.positive { background: #0d1a0d; border-color: #4ade80; }
    .rec-group { margin-bottom: 20px; }
    .rec-group-title { font-size: 12px; font-weight: 600; margin-bottom: 10px; padding: 4px 10px; border-radius: 6px; display: inline-block; }
    .rec-group-title.short-t { background: #0d1a2a; color: #60a5fa; }
    .rec-group-title.mid-t   { background: #150d2a; color: #a78bfa; }
    .rec-group-title.long-t  { background: #0d1a0d; color: #4ade80; }
    .rec-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: #141414; border-radius: 8px; margin-bottom: 6px; font-size: 13px; }
    .rec-ticker { font-weight: 600; }
    .rec-score  { font-size: 11px; color: #555; }
    .loading { color: #555; font-size: 13px; padding: 20px 0; }
    .remove-btn { background: none; border: none; color: #444; font-size: 14px; cursor: pointer; padding: 2px 5px; border-radius: 4px; }
    .remove-btn:hover { color: #f87171; background: none; }

    /* Rec synopsis modal */
    .modal-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); z-index: 1000; align-items: center; justify-content: center; }
    .modal-backdrop.open { display: flex; }
    .modal-box { background: #1e1e1e; border: 0.5px solid #333; border-radius: 14px; padding: 24px; width: 420px; max-width: 90vw; position: relative; box-shadow: 0 20px 60px rgba(0,0,0,0.8); }
    .modal-close { position: absolute; top: 14px; right: 16px; background: none; border: none; color: #555; font-size: 20px; cursor: pointer; padding: 0; line-height: 1; }
    .modal-close:hover { color: #e0e0e0; background: none; }
    .modal-ticker { font-size: 20px; font-weight: 600; color: #e0e0e0; }
    .modal-price  { font-size: 12px; color: #555; margin: 2px 0 16px; }
    .modal-scores { display: flex; gap: 8px; margin-bottom: 16px; }
    .modal-score-item { background: #141414; border: 0.5px solid #2a2a2a; border-radius: 8px; padding: 8px; text-align: center; flex: 1; }
    .modal-score-label { font-size: 9px; color: #555; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 3px; }
    .modal-score-val   { font-size: 15px; font-weight: 600; }
    .modal-section-title { font-size: 10px; font-weight: 600; color: #555; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
    .modal-section-body  { font-size: 12px; color: #bbb; line-height: 1.7; margin-bottom: 16px; }
    .modal-add-btn { width: 100%; padding: 10px; margin-top: 4px; }
    .modal-add-msg { font-size: 12px; min-height: 18px; margin-top: 8px; text-align: center; }
  </style>
</head>
<body>

  <h1>Stock Dashboard</h1>
  <p class="subtitle" id="last-updated">Loading...</p>

  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('rankings')">My Profiler</button>
    <button class="tab-btn"        onclick="switchTab('portfolio')">Paper Portfolio</button>
    <button class="tab-btn"        onclick="switchTab('news')">News & Recommendations</button>
  </div>

  <!-- TAB 1: RANKINGS -->
  <div class="tab-content active" id="tab-rankings">
    <div class="btn-row">
      <button class="primary" onclick="refreshData()">Refresh Now</button>
    </div>
    <div class="add-bar">
      <input type="text" id="new-ticker" placeholder="Add ticker (e.g. AAPL)" maxlength="10"
             onkeydown="if(event.key==='Enter') addTicker()" />
      <button class="primary" onclick="addTicker()">+ Add Stock</button>
      <span class="add-msg" id="add-msg"></span>
    </div>
    <div class="sort-bar">
      <span class="sort-label">Sort by:</span>
      <button class="sort-btn active-alpha" id="sort-alpha"   onclick="setSort('alpha')">Alphabetical</button>
      <button class="sort-btn"              id="sort-short"   onclick="setSort('short')">Short Term</button>
      <button class="sort-btn"              id="sort-mid"     onclick="setSort('mid')">Mid Term</button>
      <button class="sort-btn"              id="sort-long"    onclick="setSort('long')">Long Term</button>
      <button class="sort-btn"              id="sort-overall" onclick="setSort('overall')">Overall Score</button>
    </div>
    <div class="legend">
      <div class="legend-card short">
        <div class="legend-title">Short Term — days to 2 weeks</div>
        <div class="legend-desc"><strong>RSI (14-day):</strong> momentum signal — higher = stronger upward pressure. <strong>5D Change:</strong> raw price move this week. <strong>Short Interest & Beta</strong> apply penalties for excessive risk.</div>
      </div>
      <div class="legend-card mid">
        <div class="legend-title">Mid Term — 1 to 3 months</div>
        <div class="legend-desc"><strong>MA Trend:</strong> 20MA vs 50MA gap — uptrend when short MA leads. <strong>Earnings:</strong> beat/miss last 4 quarters. <strong>Revenue Growth</strong> adds/docks a point.</div>
      </div>
      <div class="legend-card long">
        <div class="legend-title">Long Term — 12 months</div>
        <div class="legend-desc"><strong>Analyst Rating:</strong> Wall Street consensus. <strong>Forward P/E</strong> gauges valuation. <strong>Institutions & Insider Activity</strong> reflect conviction from smart money.</div>
      </div>
    </div>

    <button class="legend-toggle" onclick="toggleMetricLegend(this)">
      <span class="legend-toggle-arrow">▶</span> Metric Reference Guide
    </button>
    <div class="metric-legend" id="metric-legend">
      <div class="metric-legend-grid">

        <div class="metric-block">
          <div class="metric-block-title">RSI (14-day) — Short Term</div>
          <div class="metric-block-desc">Momentum indicator (0–100). Measures how strongly a stock has been moving. <em>This system rewards momentum</em>, so high RSI = bullish signal, not "overbought." A stock can score 10/10 short term with RSI 80+ if other signals agree.</div>
          <table class="metric-table">
            <tr><td>≥75 — very strong momentum</td><td class="good">+3 pts</td></tr>
            <tr><td>65–74 — strong momentum</td><td class="good">+2 pts</td></tr>
            <tr><td>55–64 — mild momentum</td><td class="good">+1 pt</td></tr>
            <tr><td>45–54 — neutral</td><td class="neu">0</td></tr>
            <tr><td>36–44 — mild weakness</td><td class="bad">−1 pt</td></tr>
            <tr><td>26–35 — weak / fading</td><td class="bad">−2 pts</td></tr>
            <tr><td>≤25 — extreme weakness</td><td class="bad">−3 pts</td></tr>
          </table>
        </div>

        <div class="metric-block">
          <div class="metric-block-title">Short Interest — Short Term</div>
          <div class="metric-block-desc">% of tradeable shares currently sold short (borrowed and sold, betting on a drop). High short interest = significant bearish conviction against the stock. Can also trigger short squeezes if the stock rises and shorts scramble to cover.</div>
          <table class="metric-table">
            <tr><td>&lt;10% — low bearish bets</td><td class="good">no penalty</td></tr>
            <tr><td>10–25% — moderate</td><td class="neu">no penalty</td></tr>
            <tr><td>&gt;25% — heavy shorting</td><td class="bad">−1 pt</td></tr>
          </table>
        </div>

        <div class="metric-block">
          <div class="metric-block-title">Beta — Short Term</div>
          <div class="metric-block-desc">Volatility vs. the S&P 500. Beta 1.0 = moves with the market. Higher beta = bigger swings in both directions. Very high beta adds uncertainty to short-term calls, so this system docks a point.</div>
          <table class="metric-table">
            <tr><td>&lt;1.0 — less volatile than market</td><td class="good">no penalty</td></tr>
            <tr><td>1.0–2.5 — normal small/mid-cap range</td><td class="neu">no penalty</td></tr>
            <tr><td>&gt;2.5 — very volatile</td><td class="bad">−1 pt</td></tr>
          </table>
        </div>

        <div class="metric-block">
          <div class="metric-block-title">Forward P/E — Long Term</div>
          <div class="metric-block-desc">Price ÷ expected earnings per share (next 12 months). How much you're paying per dollar of future profits. Negative = company expected to lose money. Very high = expensive growth premium.</div>
          <table class="metric-table">
            <tr><td>&lt;8 — deep value</td><td class="good">+1 pt</td></tr>
            <tr><td>8–20 — reasonable</td><td class="neu">0</td></tr>
            <tr><td>20–50 — growth premium</td><td class="neu">0</td></tr>
            <tr><td>&gt;50 — expensive</td><td class="bad">−1 pt</td></tr>
            <tr><td>Negative — losing money</td><td class="bad">−1 pt</td></tr>
          </table>
        </div>

        <div class="metric-block">
          <div class="metric-block-title">Institutions — Long Term</div>
          <div class="metric-block-desc">% of shares held by mutual funds, ETFs, pension funds, and hedge funds. High institutional ownership signals quality and analyst coverage. Low ownership means the "smart money" may be avoiding it — or hasn't discovered it yet.</div>
          <table class="metric-table">
            <tr><td>&gt;80% — heavy institutional backing</td><td class="good">+1 pt</td></tr>
            <tr><td>25–80% — normal range</td><td class="neu">0</td></tr>
            <tr><td>&lt;25% — under the radar</td><td class="bad">−1 pt</td></tr>
          </table>
        </div>

        <div class="metric-block">
          <div class="metric-block-title">Insider Activity — Long Term</div>
          <div class="metric-block-desc">Net buying or selling by executives and board members (SEC-reported, last 90 days). Insiders buying with their own money is one of the strongest bullish signals — they know the company better than anyone. Selling is a weaker signal (could be taxes or option exercises).</div>
          <table class="metric-table">
            <tr><td>Net buying — insiders loading up</td><td class="good">+1 pt</td></tr>
            <tr><td>Neutral — routine / balanced</td><td class="neu">0</td></tr>
            <tr><td>Net selling — insiders reducing</td><td class="bad">−1 pt</td></tr>
          </table>
        </div>

      </div>
      <div style="margin-top:14px; padding-top:10px; border-top:0.5px solid #2a2a2a; font-size:10px; color:#444; line-height:1.6;">
        Score colors: <span style="color:#4ade80">■</span> 7–10 strong &nbsp;|&nbsp; <span style="color:#fbbf24">■</span> 4–6 moderate &nbsp;|&nbsp; <span style="color:#f87171">■</span> 0–3 weak &nbsp;|&nbsp; All scores start at a base of 5/10, then signals add or subtract points. Overall = Short×25% + Mid×40% + Long×35%.
      </div>
    </div>

    <div class="alerts" id="alerts"></div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="group-price"   colspan="5">Price & Changes</th>
            <th class="group-header group-short"   colspan="2">Short Term (days–2 wks)</th>
            <th class="group-header group-mid"     colspan="2">Mid Term (1–3 months)</th>
            <th class="group-header group-long"    colspan="2">Long Term (12 months)</th>
            <th class="group-header group-overall" colspan="1">Score</th>
            <th class="group-trade"  colspan="3"></th>
          </tr>
          <tr>
            <th></th>
            <th>Ticker</th>
            <th>Price</th>
            <th>1D</th>
            <th>1Mo</th>
            <th class="short">RSI (14d)</th>
            <th class="short">5D Change</th>
            <th class="mid">MA Trend</th>
            <th class="mid">Earnings (4 qtrs)</th>
            <th class="long">Analyst Rating</th>
            <th class="long">Prev Rating</th>
            <th class="overall">Overall /10</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody id="stock-table">
          <tr><td colspan="13" class="loading">Loading stocks...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- TAB 2: PORTFOLIO -->
  <div class="tab-content" id="tab-portfolio">
    <div class="portfolio-bar" style="margin-top:8px">
      <div class="stat-card"><div class="stat-label">Total Value</div><div class="stat-value" id="pf-total">—</div></div>
      <div class="stat-card"><div class="stat-label">Cash Available</div><div class="stat-value" id="pf-cash">—</div></div>
      <div class="stat-card"><div class="stat-label">Invested</div><div class="stat-value" id="pf-invested">—</div></div>
      <div class="stat-card"><div class="stat-label">Return</div><div class="stat-value" id="pf-return">—</div></div>
    </div>
    <div class="portfolio-grid">
      <div class="port-card">
        <div class="port-card-title">Buy Stocks</div>
        <div class="buy-panel">
          <div class="buy-row">
            <select id="buy-ticker-select"><option value="">Select ticker</option></select>
          </div>
          <div class="buy-row">
            <input type="number" id="buy-amount-input" placeholder="Amount in $" min="0.01" step="0.01" oninput="updateBuyPreview()" />
          </div>
          <div class="buy-hint" id="buy-preview">Enter a dollar amount — fractional shares supported</div>
          <button class="primary" onclick="doBuy()" style="width:100%;padding:10px">Buy</button>
          <div class="buy-result" id="buy-result"></div>
        </div>
      </div>
      <div class="port-card">
        <div class="port-card-title">Holdings</div>
        <div id="holdings-list"><p class="loading">No holdings yet.</p></div>
      </div>
    </div>
    <div class="port-card" style="margin-bottom:28px">
      <div class="port-card-title">Trade History</div>
      <div id="history-list"><p class="loading">No trades yet.</p></div>
    </div>
  </div>

  <!-- TAB 3: NEWS -->
  <div class="tab-content" id="tab-news">
    <div class="btn-row" style="margin-top:8px">
      <button class="primary" onclick="loadNewsTab()">Refresh News</button>
    </div>
    <div class="news-grid">
      <div>
        <div class="news-section-title">Changes Since Last Refresh</div>
        <div id="rating-changes"><p class="loading">Loading...</p></div>
        <div class="news-section-title">New Recommendations to Consider</div>
        <div id="ai-recs"><p class="loading">Loading recommendations...</p></div>
        <div class="news-section-title" style="margin-top:24px">Top Picks From Watchlist</div>
        <div class="rec-group">
          <div class="rec-group-title short-t">Short Term</div>
          <div id="rec-short"></div>
        </div>
        <div class="rec-group">
          <div class="rec-group-title mid-t">Mid Term</div>
          <div id="rec-mid"></div>
        </div>
        <div class="rec-group">
          <div class="rec-group-title long-t">Long Term</div>
          <div id="rec-long"></div>
        </div>
      </div>
      <div>
        <div class="news-section-title">Market News</div>
        <div id="market-news"><p class="loading">Loading news...</p></div>
      </div>
    </div>
  </div>

  <script>
    let stockData   = [];
    let recsData    = {};
    let currentSort = "alpha";
    let currentTab  = "rankings";

    function openRecModal(ticker) {
      const r = recsData[ticker];
      if (!r) return;
      const color = r.overall >= 7 ? "#4ade80" : r.overall >= 4.5 ? "#fbbf24" : "#f87171";
      document.getElementById("modal-ticker").textContent = r.ticker;
      const priceStr = "$" + (typeof r.price === "number" ? r.price.toFixed(2) : r.price);
      const targetStr = r.target_mean
        ? "  ·  analyst target $" + r.target_mean + (r.target_upside != null ? " (" + (r.target_upside >= 0 ? "+" : "") + r.target_upside + "%)" : "")
        : "";
      document.getElementById("modal-price").textContent = priceStr + targetStr;
      document.getElementById("modal-scores").innerHTML = [
        ["Short",   r.short,   "#60a5fa"],
        ["Mid",     r.mid,     "#a78bfa"],
        ["Long",    r.long,    "#4ade80"],
        ["Overall", r.overall, color]
      ].map(([label, val, c]) =>
        '<div class="modal-score-item">'
        + '<div class="modal-score-label">' + label + '</div>'
        + '<div class="modal-score-val" style="color:' + c + '">' + val + '/10</div>'
        + '</div>'
      ).join("");
      document.getElementById("modal-overview").textContent =
        r.overview || "AI synopsis not yet available — check back after the next recommendation scan.";
      const addBtn = document.getElementById("modal-add-btn");
      addBtn.textContent = "+ Add to Watchlist";
      addBtn.disabled = false;
      addBtn.onclick = () => addRecToWatchlist(ticker, addBtn, true);
      document.getElementById("modal-add-msg").textContent = "";
      document.getElementById("rec-modal").classList.add("open");
    }

    function closeRecModal(e) {
      if (e.target.id === "rec-modal") document.getElementById("rec-modal").classList.remove("open");
    }

    function addRecToWatchlist(ticker, btn, inModal) {
      if (btn) { btn.textContent = "Adding..."; btn.disabled = true; }
      fetch("/api/watchlist/add/" + ticker).then(r => r.json()).then(d => {
        if (btn) { btn.textContent = d.success ? "✓ Added" : "+ Add to Watchlist"; btn.disabled = false; }
        if (inModal) {
          const msg = document.getElementById("modal-add-msg");
          msg.textContent = d.success ? ticker + " added to your watchlist!" : d.error;
          msg.style.color = d.success ? "#4ade80" : "#f87171";
        }
        if (d.success) loadStocks();
      });
    }

    function toggleMetricLegend(btn) {
      const panel = document.getElementById('metric-legend');
      const arrow = btn.querySelector('.legend-toggle-arrow');
      const isOpen = panel.classList.toggle('open');
      arrow.classList.toggle('open', isOpen);
    }

    function switchTab(tab) {
      currentTab = tab;
      document.querySelectorAll(".tab-btn").forEach((b,i) => {
        b.classList.toggle("active", ["rankings","portfolio","news"][i] === tab);
      });
      document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));
      document.getElementById(`tab-${tab}`).classList.add("active");
      if (tab === "portfolio") loadPortfolioTab();
      if (tab === "news")      loadNewsTab();
    }

    function scoreShort(s) {
      let score = 5;
      const rsi = s.rsi;
      if (rsi != null) {
        if      (rsi >= 75) score += 3;
        else if (rsi >= 65) score += 2;
        else if (rsi >= 55) score += 1;
        else if (rsi <= 25) score -= 3;
        else if (rsi <= 35) score -= 2;
        else if (rsi <= 45) score -= 1;
      }
      const c5 = s.change_5d || 0;
      if      (c5 >  5) score += 2;
      else if (c5 >  2) score += 1;
      else if (c5 < -5) score -= 2;
      else if (c5 < -2) score -= 1;
      if (s.short_percent != null && s.short_percent > 0.25) score -= 1;
      if (s.beta != null && s.beta > 2.5) score -= 1;
      if (s.sentiment_label === "positive") score += 1;
      else if (s.sentiment_label === "negative") score -= 1;
      return Math.max(0, Math.min(10, score));
    }
    function scoreMid(s) {
      let score = 5;
      const ma20 = s.ma20, ma50 = s.ma50;
      if (ma20 && ma50 && ma50 > 0) {
        const gap = (ma20 - ma50) / ma50 * 100;
        if      (gap >  5) score += 3;
        else if (gap >  2) score += 2;
        else if (gap >  0) score += 1;
        else if (gap > -2) score -= 1;
        else if (gap > -5) score -= 2;
        else               score -= 3;
      } else if (s.ma_trend === "Uptrend")   score += 2;
        else if (s.ma_trend === "Downtrend") score -= 2;
      const e = s.earnings_trend || "";
      if      (e.includes("Beat x4"))   score += 3;
      else if (e.includes("Beat x3"))   score += 2;
      else if (e.includes("Beat x2"))   score += 1;
      else if (e.includes("Missed x4")) score -= 3;
      else if (e.includes("Missed x3")) score -= 2;
      else if (e.includes("Missed x2")) score -= 1;
      const rev = s.revenue_growth;
      if (rev != null) {
        if      (rev >  0.15) score += 1;
        else if (rev < -0.10) score -= 1;
      }
      return Math.max(0, Math.min(10, score));
    }
    function scoreLong(s) {
      let score = ({"Strong Buy":10,"Buy":8,"Hold":5,"Sell":2,"Strong Sell":0,"N/A":5}[s.rating] ?? 5);
      const fpe = s.forward_pe;
      if (fpe != null) {
        if      (fpe < 0)  score -= 1;
        else if (fpe < 8)  score += 1;
        else if (fpe > 50) score -= 1;
      }
      const inst = s.held_pct_institutions;
      if (inst != null) {
        if      (inst > 0.80) score += 1;
        else if (inst < 0.25) score -= 1;
      }
      if (s.insider_signal === "buying")  score += 1;
      else if (s.insider_signal === "selling") score -= 1;
      return Math.max(0, Math.min(10, score));
    }
    function scoreOverall(s) {
      return Math.round((scoreShort(s)*0.25 + scoreMid(s)*0.40 + scoreLong(s)*0.35)*10)/10;
    }

    function setSort(mode) {
      currentSort = mode;
      ["alpha","short","mid","long","overall"].forEach(m => {
        document.getElementById(`sort-${m}`).className = `sort-btn${mode===m?` active-${m}`:""}`;
      });
      renderTable(stockData);
    }
    function sortedData(data) {
      const d = [...data];
      if (currentSort === "alpha")   return d.sort((a,b) => a.ticker.localeCompare(b.ticker));
      if (currentSort === "short")   return d.sort((a,b) => scoreShort(b)   - scoreShort(a));
      if (currentSort === "mid")     return d.sort((a,b) => scoreMid(b)     - scoreMid(a));
      if (currentSort === "long")    return d.sort((a,b) => scoreLong(b)    - scoreLong(a));
      if (currentSort === "overall") return d.sort((a,b) => scoreOverall(b) - scoreOverall(a));
      return d;
    }

    function changeDisplay(v) {
      if (v===null||v===undefined) return `<span style="color:#555">—</span>`;
      const cls=v>=0?"pos":"neg", sign=v>=0?"+":"";
      return `<span class="change ${cls}">${sign}${v.toFixed(2)}%</span>`;
    }
    function rsiBadge(rsi,label) {
      if (!rsi||label==="N/A") return `<span class="badge na">N/A</span>`;
      const cls=label==="Bullish"?"bullish":label==="Bearish"?"bearish":"neutral";
      return `<span class="badge ${cls}">${rsi}</span><div class="sub-text">${label}</div>`;
    }
    function maTrendBadge(trend,ma20,ma50) {
      if (!trend||trend==="N/A") return `<span class="badge na">N/A</span>`;
      const cls=trend==="Uptrend"?"uptrend":trend==="Downtrend"?"downtrend":"flat";
      const detail=ma20&&ma50?`<div class="sub-text">20MA $${ma20} / 50MA $${ma50}</div>`:"";
      return `<span class="badge ${cls}">${trend}</span>${detail}`;
    }
    function earningsDisplay(t) {
      if (!t||t==="N/A") return `<span style="color:#555">N/A</span>`;
      if (t.includes("Beat"))   return `<span class="earnings-beat">${t}</span>`;
      if (t.includes("Missed")) return `<span class="earnings-miss">${t}</span>`;
      return `<span class="earnings-mixed">${t}</span>`;
    }
    function ratingBadge(r,total,updatedAt) {
      const map={"Strong Buy":"strong-buy","Buy":"buy","Hold":"hold","Sell":"sell","Strong Sell":"strong-sell","N/A":"na"};
      let html=`<span class="badge ${map[r]||'na'}">${r||'N/A'}</span>`;
      if (total&&total>0) html+=`<div class="analyst-breakdown">${total} analysts</div>`;
      if (updatedAt&&updatedAt!=="unknown") html+=`<div class="rating-ts">Updated ${updatedAt}</div>`;
      return html;
    }
    function tooltipHtml(s) {
      const st=scoreShort(s), mt=scoreMid(s), lt=scoreLong(s), ov=scoreOverall(s);
      const shortR=s.rsi_label==="Bullish"?"RSI bullish, positive momentum":s.rsi_label==="Bearish"?"RSI bearish, negative momentum":"RSI neutral";
      const midR=(s.ma_trend==="Uptrend"?"20MA above 50MA":s.ma_trend==="Downtrend"?"20MA below 50MA":"MAs flat")+" — "+(s.earnings_trend||"no earnings data");
      const longR=s.rating!=="N/A"?`${s.rating} from ${s.total_analysts||"?"} analysts`:"No analyst coverage";
      const fmt = (v, suffix="", decimals=1) => v != null ? `${(v*100).toFixed(decimals)}${suffix}` : "—";
      const fmtPE = v => v != null ? `${v.toFixed(1)}x` : "—";
      const fmtBeta = v => v != null ? v.toFixed(2) : "—";
      const shortPctColor  = s.short_percent > 0.25 ? "#f87171" : s.short_percent > 0.10 ? "#fbbf24" : "#4ade80";
      const revColor       = s.revenue_growth > 0.15 ? "#4ade80" : s.revenue_growth < -0.10 ? "#f87171" : "#e0e0e0";
      const betaColor      = s.beta > 2.5 ? "#f87171" : s.beta > 1.5 ? "#fbbf24" : "#e0e0e0";
      const fpeColor       = s.forward_pe < 0 ? "#f87171" : s.forward_pe < 8 ? "#4ade80" : s.forward_pe > 50 ? "#f87171" : "#e0e0e0";
      const instColor      = s.held_pct_institutions > 0.80 ? "#4ade80" : s.held_pct_institutions < 0.25 ? "#f87171" : "#e0e0e0";
      const sentColor      = s.sentiment_label === "positive" ? "#4ade80" : s.sentiment_label === "negative" ? "#f87171" : "#888";
      const insiderColor   = s.insider_signal === "buying" ? "#4ade80" : s.insider_signal === "selling" ? "#f87171" : "#888";
      const insiderText    = s.insider_signal === "buying"
        ? `Net +${(s.insider_buys||0).toLocaleString()} shares bought`
        : s.insider_signal === "selling"
        ? `Net ${(s.insider_net||0).toLocaleString()} shares sold`
        : "No significant activity";
      const sentText = s.sentiment_score != null
        ? `${s.sentiment_label} (${s.sentiment_score > 0 ? "+" : ""}${s.sentiment_score})`
        : "No data";
      const tag = (affects) => `<span style="font-size:9px;color:#444;margin-left:4px">${affects}</span>`;
      const hasFund = s.short_percent != null || s.revenue_growth != null || s.forward_pe != null;
      const fundHtml = hasFund ? `
        <hr class="tooltip-divider">
        <div style="font-size:10px;font-weight:600;color:#555;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px">Fundamentals</div>
        <div class="tooltip-row"><span class="tooltip-label">News Sentiment${tag('→ S')}</span><span class="tooltip-val" style="color:${sentColor}">${sentText}</span></div>
        <div class="tooltip-row"><span class="tooltip-label">Short Interest${tag('→ S')}</span><span class="tooltip-val" style="color:${shortPctColor}">${fmt(s.short_percent,'%')}</span></div>
        <div class="tooltip-row"><span class="tooltip-label">Beta${tag('→ S')}</span><span class="tooltip-val" style="color:${betaColor}">${fmtBeta(s.beta)}</span></div>
        <div class="tooltip-row"><span class="tooltip-label">Revenue Growth${tag('→ M')}</span><span class="tooltip-val" style="color:${revColor}">${fmt(s.revenue_growth,'%')}</span></div>
        <div class="tooltip-row"><span class="tooltip-label">Forward P/E${tag('→ L')}</span><span class="tooltip-val" style="color:${fpeColor}">${fmtPE(s.forward_pe)}</span></div>
        <div class="tooltip-row"><span class="tooltip-label">Institutions${tag('→ L')}</span><span class="tooltip-val" style="color:${instColor}">${fmt(s.held_pct_institutions,'%')}</span></div>
        <div class="tooltip-row"><span class="tooltip-label">Insider Activity${tag('→ L')}</span><span class="tooltip-val" style="color:${insiderColor}">${insiderText}</span></div>` : "";
      return `<div class="tooltip">
        <div class="tooltip-row"><span class="tooltip-label">Short Term</span><span class="tooltip-val">${st}/10</span></div>
        <div style="font-size:10px;color:#555;margin:-2px 0 4px">${shortR}</div>
        <div class="tooltip-row"><span class="tooltip-label">Mid Term</span><span class="tooltip-val">${mt}/10</span></div>
        <div style="font-size:10px;color:#555;margin:-2px 0 4px">${midR}</div>
        <div class="tooltip-row"><span class="tooltip-label">Long Term</span><span class="tooltip-val">${lt}/10</span></div>
        <div style="font-size:10px;color:#555;margin:-2px 0 4px">${longR}</div>
        <hr class="tooltip-divider">
        <div class="tooltip-total"><span>Overall (25/40/35%)</span><span>${ov}/10</span></div>
        ${fundHtml}
      </div>`;
    }
    function scoreRing(score) {
      if (score===null||score===undefined) return `<div class="score-ring s-na">—</div>`;
      const cls=score>=7?"s-high":score>=4.5?"s-mid":"s-low";
      return `<div class="score-ring ${cls}">${score}</div>`;
    }

    function newsTooltipHtml(s) {
      const headlines = s.news_headlines || [];
      const sentColor = s.sentiment_label === "positive" ? "#4ade80"
                      : s.sentiment_label === "negative" ? "#f87171" : "#888";
      const sentText  = s.sentiment_label
        ? `${s.sentiment_label}${s.sentiment_score != null ? ` (${s.sentiment_score > 0 ? "+" : ""}${(+s.sentiment_score).toFixed(2)})` : ""}`
        : "no data";

      if (!headlines.length && !s.sentiment_label) {
        return `<button class="news-btn" style="opacity:0.35;cursor:default">News</button>`;
      }

      let headlinesHtml = headlines.length
        ? headlines.map(h => `
            <div class="news-headline">
              ${h.url ? `<a href="${h.url}" target="_blank" rel="noopener">${h.title}</a>` : h.title}
              ${h.source ? `<div class="news-source">${h.source}</div>` : ""}
            </div>`).join("")
        : `<div class="no-hist">No recent headlines.</div>`;

      return `<button class="news-btn">News</button>
        <div class="news-tooltip">
          <div class="news-sent-row">
            <span class="news-sent-label">14-Day Sentiment</span>
            <span style="color:${sentColor};font-weight:600">${sentText}</span>
          </div>
          ${headlinesHtml}
        </div>`;
    }

    function loadHistoryTooltip(ticker) {
      const el = document.getElementById(`hl-${ticker}`);
      if (!el || el.dataset.loaded) return;
      el.dataset.loaded = "1";
      fetch(`/api/score-history/${ticker}`).then(r=>r.json()).then(entries => {
        if (!entries || entries.length === 0) {
          el.innerHTML = `<div class="no-hist">No history recorded yet.</div>`;
          return;
        }
        let html = `<div class="hist-row header">
          <span>Date</span>
          <span style="text-align:center">Price</span>
          <span style="text-align:center">Short</span>
          <span style="text-align:center">Mid</span>
          <span style="text-align:center">Long</span>
          <span style="text-align:center">Overall</span>
        </div>`;
        [...entries].reverse().forEach(e => {
          const priceStr = e.price != null ? `$${e.price.toFixed(2)}` : "—";
          html += `<div class="hist-row">
            <span class="hist-date">${e.date}</span>
            <span class="hist-val" style="color:#888">${priceStr}</span>
            <span class="hist-val">${e.short}</span>
            <span class="hist-val">${e.mid}</span>
            <span class="hist-val">${e.long}</span>
            <span class="hist-val">${e.overall}</span>
          </div>`;
        });
        el.innerHTML = html;
      });
    }

    function renderTable(data) {
      const tbody  = document.getElementById("stock-table");
      const alerts = document.getElementById("alerts");
      alerts.innerHTML = "";
      let rows = "";
      sortedData(data).forEach((s,i) => {
        if (s.alert) alerts.innerHTML += `<div class="alert-box">${s.ticker}: analyst rating changed — ${s.previous_rating} to ${s.rating}</div>`;
        const ov = scoreOverall(s);
        rows += `<tr class="${s.alert?'alert-row':''}">
          <td><button class="remove-btn" onclick="removeTicker('${s.ticker}')" title="Remove">x</button></td>
          <td><strong>${s.ticker}</strong>${currentSort!=="alpha"?`<div class="sub-text">#${i+1}</div>`:""}</td>
          <td>$${typeof s.price==="number"?s.price.toFixed(2):s.price}</td>
          <td>${changeDisplay(s.change_1d)}</td>
          <td>${changeDisplay(s.change_1mo)}</td>
          <td>${rsiBadge(s.rsi,s.rsi_label)}</td>
          <td>${changeDisplay(s.change_5d)}</td>
          <td>${maTrendBadge(s.ma_trend,s.ma20,s.ma50)}</td>
          <td>${earningsDisplay(s.earnings_trend)}</td>
          <td>${ratingBadge(s.rating,s.total_analysts,s.rating_updated)}</td>
          <td>${ratingBadge(s.previous_rating)}</td>
          <td class="score-cell">${scoreRing(ov)}${tooltipHtml(s)}</td>
          <td class="hist-cell" onmouseenter="loadHistoryTooltip('${s.ticker}')">
            <button class="hist-btn">History</button>
            <div class="hist-tooltip">
              <div class="hist-title">Score History — ${s.ticker}</div>
              <div id="hl-${s.ticker}"><span class="loading">Loading...</span></div>
            </div>
          </td>
          <td class="news-cell">
            ${newsTooltipHtml(s)}
          </td>
        </tr>`;
      });
      tbody.innerHTML = rows;
    }

    function loadStocks() {
      fetch("/api/stocks").then(r=>r.json()).then(data => {
        stockData = data;
        renderTable(data);
        document.getElementById("last-updated").textContent =
          data.length>0 ? `Last updated: ${data[0].updated}` : "No data yet";
        populateBuySelect(data);
      });
    }

    function loadPortfolioTab() {
      fetch("/api/portfolio").then(r=>r.json()).then(p => {
        const startingValue = 100;
        const totalValue    = p.total_value || 0;
        const returnVal     = totalValue - startingValue;
        const returnPct     = ((returnVal/startingValue)*100).toFixed(2);
        document.getElementById("pf-total").textContent    = `$${totalValue.toFixed(2)}`;
        document.getElementById("pf-cash").textContent     = `$${p.cash.toFixed(2)}`;
        document.getElementById("pf-invested").textContent = `$${(p.holdings_value||0).toFixed(2)}`;
        const el = document.getElementById("pf-return");
        el.textContent = `${returnVal>=0?"+":""}$${returnVal.toFixed(2)} (${returnPct}%)`;
        el.className   = `stat-value ${returnVal>=0?"green":"red"}`;
        const holdingsEl = document.getElementById("holdings-list");
        if (!p.holdings || Object.keys(p.holdings).length === 0) {
          holdingsEl.innerHTML = `<p style="color:#555;font-size:13px">No holdings yet.</p>`;
        } else {
          holdingsEl.innerHTML = Object.entries(p.holdings).map(([ticker, shares]) => {
            const stock    = stockData.find(s => s.ticker === ticker);
            const price    = stock ? stock.price : 0;
            const value    = price ? shares * price : 0;
            const buyTotal = p.history.filter(h=>h.action==="BUY"&&h.ticker===ticker).reduce((a,h)=>a+h.amount,0);
            const pnl      = value - buyTotal;
            // gather all buy lots for this ticker
            const lots = p.history.filter(h => h.action === "BUY" && h.ticker === ticker);
            const lotStock = stockData.find(s => s.ticker === ticker) || {};
            const shortScore = lotStock ? scoreShort(lotStock) : "—";
            const midScore   = lotStock ? scoreMid(lotStock)   : "—";
            const longScore  = lotStock ? scoreLong(lotStock)  : "—";
            let lotRows = lots.map(lot => `
              <div class="lot-row"><span class="lot-label">Date</span><span class="lot-val">${lot.date}</span></div>
              <div class="lot-row"><span class="lot-label">Amount</span><span class="lot-val">$${lot.amount.toFixed(2)}</span></div>
              <div class="lot-row"><span class="lot-label">Price at buy</span><span class="lot-val">${lot.price !== "pending" ? "$"+parseFloat(lot.price).toFixed(2) : "pending"}</span></div>
              <div class="lot-row"><span class="lot-label">Shares</span><span class="lot-val">${lot.shares}</span></div>
              <div style="border-top:0.5px solid #2a2a2a;margin:6px 0"></div>
              <div class="lot-row"><span class="lot-label">Short (at purchase)</span><span class="lot-val" style="color:#60a5fa">${lot.short_score_at_buy ?? "—"}/10</span></div>
              <div class="lot-row"><span class="lot-label">Mid (at purchase)</span><span class="lot-val" style="color:#a78bfa">${lot.mid_score_at_buy ?? "—"}/10</span></div>
              <div class="lot-row"><span class="lot-label">Long (at purchase)</span><span class="lot-val" style="color:#4ade80">${lot.long_score_at_buy ?? "—"}/10</span></div>
            `).join("");
            return `<div class="holdings-row">
              <div>
                <div class="holding-ticker">${ticker}</div>
                <div class="holding-detail">${shares.toFixed(4)} shares @ $${price||"—"}</div>
              </div>
              <div class="holding-value">
                <div>$${value.toFixed(2)}</div>
                <div class="holding-pnl ${pnl>=0?'pos':'neg'}">${pnl>=0?"+":""}$${pnl.toFixed(2)}</div>
              </div>
              <div class="lot-cell">
                <button class="lot-btn">Lots</button>
                <div class="lot-tooltip">
                  <div class="lot-title">Lot Details — ${ticker}</div>
                  ${lotRows}
                </div>
              </div>
              <button class="danger" style="font-size:12px;padding:5px 10px" onclick="doSell('${ticker}')">Sell All</button>
            </div>`;
          }).join("");
        }
        const histEl = document.getElementById("history-list");
        if (!p.history || p.history.length === 0) {
          histEl.innerHTML = `<p style="color:#555;font-size:13px">No trades yet.</p>`;
        } else {
          histEl.innerHTML = [...p.history].reverse().map(h =>
            `<div class="history-item ${h.action==='BUY'?'history-buy':'history-sell'}">
              <span><strong>${h.action}</strong> ${h.ticker}</span>
              <span>${h.shares} shares @ $${h.price}</span>
              <span style="color:${h.action==='BUY'?'#f87171':'#4ade80'}">${h.action==='BUY'?`-$${h.amount}`:`+$${h.value}`}</span>
              <span style="color:#555">${h.date}</span>
            </div>`
          ).join("");
        }
      });
    }

    function populateBuySelect(data) {
      const sel = document.getElementById("buy-ticker-select");
      const cur = sel.value;
      sel.innerHTML = `<option value="">Select ticker</option>` +
        data.map(s=>`<option value="${s.ticker}" data-price="${s.price}">${s.ticker} — $${typeof s.price==="number"?s.price.toFixed(2):s.price}</option>`).join("");
      if (cur) sel.value = cur;
    }

    function updateBuyPreview() {
      const sel    = document.getElementById("buy-ticker-select");
      const amount = parseFloat(document.getElementById("buy-amount-input").value);
      const opt    = sel.options[sel.selectedIndex];
      const price  = opt ? parseFloat(opt.getAttribute("data-price")) : null;
      const hint   = document.getElementById("buy-preview");
      if (sel.value && price && amount > 0) {
        hint.textContent = `You will receive ~${(amount/price).toFixed(4)} shares of ${sel.value}`;
        hint.style.color = "#4ade80";
      } else {
        hint.textContent = "Enter a dollar amount — fractional shares supported";
        hint.style.color = "#555";
      }
    }

    function doBuy() {
      const ticker = document.getElementById("buy-ticker-select").value;
      const amount = parseFloat(document.getElementById("buy-amount-input").value);
      const result = document.getElementById("buy-result");
      if (!ticker) { result.className="buy-error"; result.textContent="Please select a ticker."; return; }
      if (!amount||amount<=0) { result.className="buy-error"; result.textContent="Enter a valid dollar amount."; return; }
      fetch(`/api/buy/${ticker}?amount=${amount}`).then(r=>r.json()).then(d => {
        result.className   = d.success ? "buy-result" : "buy-error";
        result.textContent = d.success ? d.message : d.error;
        if (d.success) loadPortfolioTab();
        setTimeout(()=>{ result.textContent=""; }, 5000);
      });
    }

    function doSell(ticker) {
      if (!confirm(`Sell all ${ticker}?`)) return;
      fetch(`/api/sell/${ticker}`).then(r=>r.json()).then(d => {
        if (d.success) loadPortfolioTab(); else alert(d.error);
      });
    }

    function loadNewsTab() {
      const changesEl = document.getElementById("rating-changes");
      const ratingChanged = stockData.filter(s => s.alert);
      const scoreChanged  = stockData.filter(s => s.score_changes && s.score_changes.length > 0);
      if (ratingChanged.length === 0 && scoreChanged.length === 0) {
        changesEl.innerHTML = `<p style="color:#555;font-size:13px">No changes since last refresh.</p>`;
      } else {
        const dimLabel = { short: "Short Term", mid: "Mid Term", long: "Long Term", overall: "Overall" };
        let html = "";
        ratingChanged.forEach(s => {
          const positive = ["Strong Buy","Buy"].includes(s.rating);
          html += `<div class="change-card ${positive?'positive':''}"><strong>${s.ticker}</strong> — analyst rating ${s.previous_rating} → <strong>${s.rating}</strong></div>`;
        });
        scoreChanged.forEach(s => {
          s.score_changes.forEach(c => {
            const dropped = c.to < c.from;
            const bigDrop = dropped && (c.from - c.to) >= 2;
            let note = "";
            if (c.dim === "overall" && bigDrop)    note = " — consider selling";
            else if (c.dim === "overall" && dropped) note = " — watch closely";
            else if (c.dim === "overall" && !dropped) note = " — looking stronger";
            html += `<div class="change-card ${dropped?'':'positive'}"><strong>${s.ticker}</strong> — ${dimLabel[c.dim]} score ${c.from}/10 → <strong>${c.to}/10</strong>${note}</div>`;
          });
        });
        changesEl.innerHTML = html;
      }

      ["short","mid","long"].forEach(t => {
        const fn = t==="short"?scoreShort:t==="mid"?scoreMid:scoreLong;
        const sorted = [...stockData].sort((a,b)=>fn(b)-fn(a)).slice(0,3);
        document.getElementById(`rec-${t}`).innerHTML = sorted.map(s => {
          const detail = t==="short" ? `RSI ${s.rsi||"N/A"} — 5D ${(s.change_5d||0)>=0?"+":""}${(s.change_5d||0).toFixed(1)}%`
                       : t==="mid"  ? `${s.ma_trend||"N/A"} — ${s.earnings_trend||"N/A"}`
                       :              `${s.rating||"N/A"} — ${s.total_analysts||0} analysts`;
          return `<div class="rec-row">
            <span class="rec-ticker">${s.ticker}</span>
            <span style="color:#666;font-size:11px">${detail}</span>
            <span class="rec-score">${fn(s)}/10</span>
          </div>`;
        }).join("");
      });

      fetch("/api/recommendations").then(r=>r.json()).then(data => {
        const recs = data.results || [];
        const updatedAt = data.updated || null;
        const status = data.status || null;
        const el = document.getElementById("ai-recs");
        if (status === "building" || !recs || recs.length === 0) {
          el.innerHTML = '<p style="color:#555;font-size:13px">Scanning the market for recommendations — check back in a few minutes.</p>';
          return;
        }
        if (updatedAt) {
          el.innerHTML = '<div style="font-size:11px;color:#444;margin-bottom:10px">Last scanned: ' + updatedAt + '</div>';
        } else { el.innerHTML = ""; }
        recsData = {};
        recs.forEach(r => { recsData[r.ticker] = r; });
        el.innerHTML += recs.map(r => {
          const color = r.overall >= 7 ? "#4ade80" : r.overall >= 4.5 ? "#fbbf24" : "#f87171";
          const reasonHtml = r.reasons.length > 0
            ? '<div style="font-size:11px;color:#777;margin-top:4px">' + r.reasons.join(" · ") + '</div>'
            : "";
          const targetHtml = r.target_mean
            ? '<span style="font-size:11px;color:#555;margin-left:10px">target $' + r.target_mean
              + (r.target_upside != null ? ' <span style="color:' + (r.target_upside >= 0 ? '#4ade80' : '#f87171') + '">'
                + (r.target_upside >= 0 ? '+' : '') + r.target_upside + '%</span>' : '') + '</span>'
            : '';
          return '<div class="news-card" style="border-color:#2a2a2a;margin-bottom:10px">'
            + '<div style="display:flex;justify-content:space-between;align-items:center">'
            + '<div><span style="font-weight:600;font-size:15px;color:#e0e0e0">' + r.ticker + '</span>'
            + '<span style="font-size:12px;color:#555;margin-left:8px">$' + (typeof r.price === "number" ? r.price.toFixed(2) : r.price) + '</span>'
            + targetHtml + '</div>'
            + '<div style="text-align:right"><div style="font-size:18px;font-weight:600;color:' + color + '">' + r.overall + '/10</div>'
            + '<div style="font-size:10px;color:#555">S:' + r.short + ' M:' + r.mid + ' L:' + r.long + '</div></div></div>'
            + reasonHtml
            + '<div style="display:flex;gap:8px;margin-top:10px;border-top:0.5px solid #222;padding-top:10px">'
            + '<button style="flex:1;font-size:11px;padding:6px 0" onclick="openRecModal(\'' + r.ticker + '\')">Synopsis →</button>'
            + '<button class="primary" style="flex:1;font-size:11px;padding:6px 0" onclick="addRecToWatchlist(\'' + r.ticker + '\', this, false)">+ Add to Watchlist</button>'
            + '</div></div>';
        }).join("");
      });
      const newsEl = document.getElementById("market-news");
      newsEl.innerHTML = `<p class="loading">Fetching news...</p>`;
      fetch("/api/news").then(r=>r.json()).then(articles => {
        newsEl.innerHTML = !articles||articles.length===0
          ? `<p style="color:#555;font-size:13px">No news available.</p>`
          : articles.map(a =>
              `<div class="news-card">
                <div class="news-headline"><a href="${a.url}" target="_blank">${a.headline}</a></div>
                <div class="news-meta">${a.source} · ${a.datetime}</div>
                ${a.summary?`<div class="news-summary">${a.summary}</div>`:""}
              </div>`
            ).join("");
      });
    }

    function addTicker() {
      const input  = document.getElementById("new-ticker");
      const msg    = document.getElementById("add-msg");
      const ticker = input.value.trim().toUpperCase();
      if (!ticker) return;
      msg.textContent = `Adding ${ticker}...`;
      msg.className   = "add-msg";
      fetch(`/api/watchlist/add/${ticker}`).then(r=>r.json()).then(data => {
        msg.textContent = data.success ? data.message : data.error;
        msg.className   = `add-msg ${data.success?"ok":"err"}`;
        if (data.success) { input.value=""; setTimeout(loadStocks,500); }
        setTimeout(()=>{ msg.textContent=""; }, 5000);
      });
    }

    function removeTicker(ticker) {
      if (!confirm(`Remove ${ticker} from your watchlist?`)) return;
      fetch(`/api/watchlist/remove/${ticker}`).then(r=>r.json()).then(d => {
        if (d.success) loadStocks(); else alert(d.error);
      });
    }

    function refreshData() {
      document.getElementById("last-updated").textContent = "Refreshing in background (~2 min)...";
      fetch("/api/refresh").then(() => { setTimeout(loadStocks, 120000); });
    }

    loadStocks();
    setInterval(() => { loadStocks(); if (currentTab==="portfolio") loadPortfolioTab(); }, 60000);
    document.addEventListener("keydown", e => { if (e.key === "Escape") document.getElementById("rec-modal").classList.remove("open"); });
  </script>

  <div class="modal-backdrop" id="rec-modal" onclick="closeRecModal(event)">
    <div class="modal-box">
      <button class="modal-close" onclick="document.getElementById('rec-modal').classList.remove('open')">×</button>
      <div class="modal-ticker" id="modal-ticker"></div>
      <div class="modal-price"  id="modal-price"></div>
      <div class="modal-scores" id="modal-scores"></div>
      <div class="modal-section-title">AI Synopsis</div>
      <div class="modal-section-body" id="modal-overview"></div>
      <button class="primary modal-add-btn" id="modal-add-btn">+ Add to Watchlist</button>
      <div class="modal-add-msg" id="modal-add-msg"></div>
    </div>
  </div>
</body>
</html>
